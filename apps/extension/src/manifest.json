{
  "manifest_version": 3,
  "name": "Gunda Capture",
  "version": "0.1.0",
  "description": "Download files with Gunda.",
  "minimum_chrome_version": "116",
  "key": "",

  "permissions": ["webRequest", "storage", "tabs", "alarms", "nativeMessaging"],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["page.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],

  "options_page": "options.html"
}
